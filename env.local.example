# Copy to .env.local and fill in values.

# --- Supabase (required for /p/[shareCode] + DB persistence) ---
# Must be the project root only, e.g. https://xxxx.supabase.co
# (not .../rest/v1 or .../storage/v1 — wrong URL causes Storage/API errors)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 可选：仅服务端。配置后可用 /admin 看板做全表统计（勿提交、勿暴露给浏览器）
SUPABASE_SERVICE_ROLE_KEY=

# Optional: canonical site URL for server-side share links (otherwise VERCEL_URL / localhost)
NEXT_PUBLIC_SITE_URL=
